---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config/site";
import { getFeaturedProjects } from "../lib/projects";

// Shared, restrained button/link treatments reused across Hero and the
// closing Contact CTA — the site's only two button-style moments.
const buttonPrimary =
  "inline-flex items-center justify-center rounded-lg bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-slate-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900";
const buttonSecondary =
  "inline-flex items-center justify-center rounded-lg border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-700 hover:border-slate-900 hover:text-slate-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900";
const linkAccent =
  "rounded text-sm font-medium text-blue-600 hover:text-blue-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900";

// Section-label ("eyebrow") heading treatment, used for the more compact
// sections so the page doesn't read as a repeated heading+rule+paragraph.
const eyebrowHeading =
  "text-sm font-semibold uppercase tracking-wide text-blue-600";

const coreFocusItems = [
  {
    title: "Lead & Operate",
    description:
      "Own technical operations, incidents, cross-functional delivery, and the processes that keep systems and teams running reliably.",
  },
  {
    title: "Build & Automate",
    description:
      "Build practical cloud, CI/CD, container, and automation workflows with reliability and maintainability in mind.",
  },
  {
    title: "Data & Reliability",
    description:
      "Build and validate data workflows using automation, observability, orchestration, and data-quality practices.",
  },
] as const;

const impactItems = [
  "Measurable outcome — added in a later phase.",
  "Measurable outcome — added in a later phase.",
  "Measurable outcome — added in a later phase.",
] as const;

// Selected Work degrades gracefully with the number of featured projects
// actually available: 1 -> a single full-width card, 2 -> primary +
// one secondary side by side, 3 -> the full primary + two-stacked layout.
const featuredProjects = await getFeaturedProjects(3);
const [primaryProject, ...secondaryProjects] = featuredProjects;
const featuredCount = featuredProjects.length;

const selectedWorkGridClass =
  featuredCount <= 1
    ? "mt-8"
    : featuredCount === 2
      ? "mt-8 grid grid-cols-1 gap-6 lg:grid-cols-3"
      : "mt-8 grid grid-cols-1 gap-6 lg:grid-cols-3 lg:grid-rows-2";

const primaryCardClass =
  featuredCount <= 1
    ? "rounded-2xl border border-slate-200 bg-white p-6 sm:p-8"
    : featuredCount === 2
      ? "rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 lg:col-span-2"
      : "rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 lg:col-span-2 lg:row-span-2";

// schema.org/Person for the homepage only (SPEC §10.3). Built only from
// facts already present in siteConfig — no job title, email, location,
// employer, or education. LinkedIn joins `sameAs` automatically once
// `siteConfig.linkedinUrl` is populated; no template change needed.
const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: siteConfig.name,
  url: Astro.site?.toString(),
  sameAs: [
    siteConfig.githubUrl,
    ...(siteConfig.linkedinUrl ? [siteConfig.linkedinUrl] : []),
  ],
};
---

<BaseLayout
  title={`${siteConfig.name} — ${siteConfig.positioning}`}
  description={`${siteConfig.positioning} — ${siteConfig.focus}`}
  jsonLd={personJsonLd}
>
  <!-- Hero -->
  <section aria-labelledby="hero-heading">
    <h1
      id="hero-heading"
      class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl"
    >
      {siteConfig.name}
    </h1>
    <p class="mt-3 text-xl font-semibold text-slate-700 sm:text-2xl">
      {siteConfig.positioning}
    </p>
    <p class="mt-2 text-sm font-medium tracking-wide text-slate-500 uppercase">
      {siteConfig.focus}
    </p>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-600">
      I design, build, and operate reliable technical systems — combining
      hands-on engineering with operational ownership across cloud, automation,
      and data workflows.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a href="/projects/" class={buttonPrimary}>View Projects</a>
      <a href="/experience/" class={buttonSecondary}>Experience</a>
      {
        siteConfig.resumePath && (
          <a href={siteConfig.resumePath} class={linkAccent}>
            Resume →
          </a>
        )
      }
    </div>
  </section>

  <!-- Core Focus -->
  <section aria-labelledby="core-focus-heading" class="mt-24">
    <h2 id="core-focus-heading" class={eyebrowHeading}>Core Focus</h2>
    <div class="mt-6 grid grid-cols-1 gap-x-10 gap-y-8 sm:grid-cols-3">
      {
        coreFocusItems.map((item) => (
          <div class="border-t border-slate-200 pt-6">
            <h3 class="text-lg font-semibold text-slate-900">{item.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">
              {item.description}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Selected Work -->
  <section aria-labelledby="selected-work-heading" class="mt-24">
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <h2
        id="selected-work-heading"
        class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl"
      >
        Selected Work
      </h2>
      <a href="/projects/" class={linkAccent}>View all projects →</a>
    </div>
    <p class="mt-3 max-w-2xl text-base leading-relaxed text-slate-600">
      A few things I've built and operated. Full case studies are being migrated
      into this section in a later phase.
    </p>

    {
      !primaryProject ? (
        <p class="mt-8 max-w-2xl text-base leading-relaxed text-slate-600">
          Featured projects will be added in a later phase.
        </p>
      ) : (
        <div class={selectedWorkGridClass}>
          <article class={primaryCardClass}>
            <div class="aspect-video w-full rounded-lg border border-slate-200 bg-slate-100" />
            <p class={`mt-6 ${eyebrowHeading}`}>Featured Project</p>
            <h3 class="mt-2 text-xl font-semibold text-slate-900">
              <a
                href={`/projects/${primaryProject.id}/`}
                class="rounded focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"
              >
                {primaryProject.data.title}
              </a>
            </h3>
            <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-600">
              {primaryProject.data.description}
            </p>
            {primaryProject.data.tags.length > 0 && (
              <ul class="mt-4 flex flex-wrap gap-2">
                {primaryProject.data.tags.map((tag) => (
                  <li class="rounded-full border border-slate-200 px-3 py-1 text-xs font-medium text-slate-500">
                    {tag}
                  </li>
                ))}
              </ul>
            )}
            <a
              href={`/projects/${primaryProject.id}/`}
              class={`mt-4 inline-block ${linkAccent}`}
            >
              Case study →
            </a>
          </article>

          {secondaryProjects.map((project) => (
            <article class="rounded-2xl border border-slate-200 bg-white p-6">
              <p class={eyebrowHeading}>Featured Project</p>
              <h3 class="mt-2 text-lg font-semibold text-slate-900">
                <a
                  href={`/projects/${project.id}/`}
                  class="rounded focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"
                >
                  {project.data.title}
                </a>
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-slate-600">
                {project.data.description}
              </p>
              <a
                href={`/projects/${project.id}/`}
                class={`mt-4 inline-block ${linkAccent}`}
              >
                Case study →
              </a>
            </article>
          ))}
        </div>
      )
    }
  </section>

  <!-- Impact Snapshot -->
  <section aria-labelledby="impact-heading" class="mt-24">
    <h2 id="impact-heading" class={eyebrowHeading}>Impact Snapshot</h2>
    <div
      class="mt-6 grid grid-cols-1 divide-y divide-slate-200 sm:grid-cols-3 sm:divide-x sm:divide-y-0"
    >
      {
        impactItems.map((label) => (
          <div class="py-4 first:pt-0 sm:px-8 sm:py-0 sm:first:pl-0">
            <p class="text-3xl font-bold tracking-tight text-slate-900">—</p>
            <p class="mt-2 max-w-xs text-sm text-slate-600">{label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Short About -->
  <section aria-labelledby="about-heading" class="mt-24">
    <h2
      id="about-heading"
      class="text-2xl font-semibold tracking-tight text-slate-900"
    >
      About
    </h2>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-600">
      I'm an engineer who works across technical operations, DevOps, and data
      systems — equally comfortable owning an incident, building a deployment
      pipeline, or validating a data workflow. My focus is dependable systems,
      clear operational ownership, and automation that actually holds up in
      production. This site collects the projects, experience, and case studies
      behind that work.
    </p>
    <a href="/about/" class={`mt-4 inline-block ${linkAccent}`}
      >Read more about me →</a
    >
  </section>

  <!-- Contact CTA -->
  <section
    aria-labelledby="contact-heading"
    class="mt-24 rounded-2xl border border-slate-200 bg-slate-50 p-10 sm:p-12"
  >
    <h2
      id="contact-heading"
      class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl"
    >
      Let's Connect
    </h2>
    <p class="mt-3 max-w-xl text-base leading-relaxed text-slate-600">
      Open to technical operations, DevOps, and data engineering roles where
      reliability and ownership matter. Reach out, or start with the resume.
    </p>
    <div class="mt-6 flex flex-wrap items-center gap-4">
      {
        siteConfig.email && (
          <a href={`mailto:${siteConfig.email}`} class={buttonPrimary}>
            Email Me
          </a>
        )
      }
      {
        siteConfig.resumePath && (
          <a href={siteConfig.resumePath} class={buttonSecondary}>
            Download Resume
          </a>
        )
      }
      <a href={siteConfig.githubUrl} class={linkAccent}>GitHub</a>
      {
        siteConfig.linkedinUrl && (
          <a href={siteConfig.linkedinUrl} class={linkAccent}>
            LinkedIn
          </a>
        )
      }
    </div>
  </section>
</BaseLayout>
