---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../config/site";
import { getSortedProjects } from "../../lib/projects";

const projects = await getSortedProjects();

const linkClass =
  "rounded text-sm font-medium text-blue-600 hover:text-blue-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900";

// Degrade the listing layout by actual project count, so a small
// collection doesn't look like a mostly-empty 3-column grid: 1 project
// gets a comfortably-sized single card, 2 get a two-column layout, 3+
// use the full responsive grid. Every branch is a complete, static class
// string so Tailwind's class scanner can discover them all.
const projectCount = projects.length;
const projectsGridClass =
  projectCount === 1
    ? "mt-10 max-w-2xl"
    : projectCount === 2
      ? "mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2"
      : "mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3";
---

<BaseLayout
  title={`Projects — ${siteConfig.name}`}
  description="Engineering projects covering AWS delivery lifecycles, DevSecOps release gates, and the static architecture behind this site."
>
  <h1 class="text-4xl font-bold tracking-tight text-stone-900 sm:text-5xl">
    Projects
  </h1>

  <p class="mt-5 max-w-2xl text-base leading-relaxed text-stone-600">
    Hands-on engineering projects across infrastructure, delivery, security and
    operations.
  </p>

  {
    projects.length === 0 ? (
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-stone-600">
        No project entries are currently available.
      </p>
    ) : (
      <div class={projectsGridClass}>
        {projects.map((project) => (
          <article class="rounded-2xl border border-stone-200 bg-white p-6">
            <h2 class="text-lg font-semibold text-stone-900">
              <a
                href={`/projects/${project.id}/`}
                class="rounded focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900"
              >
                {project.data.title}
              </a>
            </h2>
            <p class="mt-3 text-sm leading-relaxed text-stone-600">
              {project.data.description}
            </p>
            {project.data.tags.length > 0 && (
              <ul class="mt-4 flex flex-wrap gap-2">
                {project.data.tags.map((tag) => (
                  <li class="rounded-full border border-stone-200 px-3 py-1 text-xs font-medium text-stone-500">
                    {tag}
                  </li>
                ))}
              </ul>
            )}
            <div class="mt-4 flex flex-wrap items-center gap-4">
              {project.data.githubUrl && (
                <a href={project.data.githubUrl} class={linkClass}>
                  GitHub ↗
                </a>
              )}
              {project.data.liveUrl && (
                <a href={project.data.liveUrl} class={linkClass}>
                  Live ↗
                </a>
              )}
              <a href={`/projects/${project.id}/`} class={linkClass}>
                Case study →
              </a>
            </div>
          </article>
        ))}
      </div>
    )
  }
</BaseLayout>
