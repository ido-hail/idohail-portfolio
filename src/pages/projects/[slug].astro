---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../config/site";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const linkClass =
  "rounded text-sm font-medium text-blue-600 hover:text-blue-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900";
---

<BaseLayout
  title={`${data.title} | ${siteConfig.name}`}
  description={data.description}
  type="article"
>
  <h1 class="text-4xl font-bold tracking-tight text-stone-900 sm:text-5xl">
    {data.title}
  </h1>
  <p class="mt-4 max-w-2xl text-lg leading-relaxed text-stone-600">
    {data.description}
  </p>

  {
    data.tags.length > 0 && (
      <ul class="mt-6 flex flex-wrap gap-2">
        {data.tags.map((tag) => (
          <li class="rounded-full border border-stone-200 px-3 py-1 text-xs font-medium text-stone-500">
            {tag}
          </li>
        ))}
      </ul>
    )
  }

  {
    (data.githubUrl || data.liveUrl) && (
      <div class="mt-6 flex flex-wrap items-center gap-6">
        {data.githubUrl && (
          <a href={data.githubUrl} class={linkClass}>
            GitHub ↗
          </a>
        )}
        {data.liveUrl && (
          <a href={data.liveUrl} class={linkClass}>
            Live ↗
          </a>
        )}
      </div>
    )
  }

  {
    /* The container is wider than the reading measure so figures can break
      out; every prose child is pinned back to max-w-2xl below, leaving the
      line length unchanged from a text-only case study. */
  }
  <div
    class="case-study mt-12 max-w-4xl text-base leading-relaxed text-stone-700"
  >
    <Content />
  </div>

  <a href="/projects/" class={`mt-12 inline-block ${linkClass}`}
    >← Back to all projects</a
  >
</BaseLayout>

<style>
  /* Minimal, hand-styled treatment for rendered Markdown case-study
     content — no typography plugin dependency for this small a surface.
     Case-study Markdown starts at h2 (the page template owns the h1). */
  .case-study :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-stone-900);
  }
  .case-study :global(h2:first-child) {
    margin-top: 0;
  }
  .case-study :global(p) {
    margin-top: 0.75rem;
  }
  .case-study :global(ul),
  .case-study :global(ol) {
    margin-top: 0.75rem;
    padding-left: 1.25rem;
  }
  .case-study :global(ul) {
    list-style-type: disc;
  }
  .case-study :global(ol) {
    list-style-type: decimal;
  }
  .case-study :global(a) {
    color: var(--color-blue-600);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .case-study :global(a:hover) {
    color: var(--color-blue-700);
  }
  .case-study :global(strong) {
    font-weight: 600;
    color: var(--color-stone-900);
  }

  /* Prose keeps the original reading measure even though the container is
     wider — only figures use the extra width. */
  .case-study :global(h2),
  .case-study :global(h3),
  .case-study :global(p),
  .case-study :global(ul),
  .case-study :global(ol) {
    max-width: 42rem;
  }

  .case-study :global(figure) {
    margin-top: 2rem;
    margin-bottom: 2rem;
  }

  .case-study :global(figure img) {
    width: 100%;
    height: auto;
    border-radius: 0.5rem;
    border: 1px solid var(--color-stone-200);
  }

  /* The diagrams are dense enough that their labels are small on a narrow
     screen, so each figure links to the full-size local asset. */
  .case-study :global(figure a) {
    display: block;
    text-decoration: none;
    border-radius: 0.5rem;
  }

  .case-study :global(figure a:focus-visible) {
    outline: 2px solid var(--color-stone-900);
    outline-offset: 2px;
  }

  .case-study :global(figcaption) {
    max-width: 42rem;
    margin-top: 0.75rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-stone-500);
  }
</style>
