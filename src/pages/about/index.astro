---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../config/site";

const prose = "max-w-2xl text-base leading-relaxed text-stone-600";
const sectionHeading =
  "text-2xl font-semibold tracking-tight text-stone-900 sm:text-3xl";
const linkAccent =
  "rounded font-medium text-blue-600 hover:text-blue-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900";

// Employment record: role, years and one factual scope line each. Ordered
// most recent first, matching how /experience/ already renders these two
// entries. Years stay at year precision to match the Experience content
// collection, and the role bullets and measured outcomes stay on
// /experience/ rather than being repeated here.
const roles = [
  {
    title: "TechOps Team Lead · YuviTal",
    meta: "2024 - 2026",
    scope:
      "Hands-on lead for a three-person technical team; production monitoring, release readiness, data-quality automation, access administration and internal tooling.",
  },
  {
    title: "TechOps Engineer · YuviTal",
    meta: "2023 - 2024",
    scope:
      "Production and staging operations, backend and database validation, incident investigation and data-flow troubleshooting.",
  },
] as const;

// Programs of study, as metadata only. Deliberately no coverage or subject
// description: the Skill Map and the case studies already carry those
// keywords. Named as programs, never as certifications.
const training = [
  {
    title: "DevSecOps Program · Analiza Education Center",
    meta: "2026 · 360 hours",
  },
  {
    title: "Cyber Security Program · See Security College",
    meta: "2021 - 2022 · 450 hours",
  },
] as const;

// One row treatment shared by both lists: title left, metadata right,
// wrapping to two lines on narrow viewports.
const listRow =
  "flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-t border-stone-200 pt-3";
---

<BaseLayout
  title={`About ${siteConfig.name} | Production & Reliability`}
  description="Ido Hail: TechOps Team Lead and TechOps Engineer at YuviTal. Project-backed cloud and infrastructure capability, and professional training."
>
  <h1 class="text-4xl font-bold tracking-tight text-stone-900 sm:text-5xl">
    About
  </h1>

  <section aria-labelledby="background-heading" class="mt-10">
    <h2 id="background-heading" class={sectionHeading}>
      Professional background
    </h2>

    <ul class="mt-6 max-w-2xl space-y-4">
      {
        roles.map((role) => (
          <li>
            <div class={listRow}>
              <span class="font-medium text-stone-900">{role.title}</span>
              <span class="text-sm text-stone-500">{role.meta}</span>
            </div>
            <p class="mt-2 text-sm leading-relaxed text-stone-600">
              {role.scope}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="cloud-heading" class="mt-16">
    <h2 id="cloud-heading" class={sectionHeading}>Cloud and infrastructure</h2>
    <p class={`mt-6 ${prose}`}>
      <a href="/projects/" class={linkAccent}>Project-backed</a> infrastructure: AWS,
      Terraform, Docker, Kubernetes/EKS, ECR, GitHub Actions/OIDC, CI/CD, Prometheus
      and Grafana.
    </p>
  </section>

  <section aria-labelledby="training-heading" class="mt-16">
    <h2 id="training-heading" class={sectionHeading}>Professional training</h2>

    <ul class="mt-6 max-w-2xl space-y-3">
      {
        training.map((program) => (
          <li class={listRow}>
            <span class="font-medium text-stone-900">{program.title}</span>
            <span class="text-sm text-stone-500">{program.meta}</span>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
