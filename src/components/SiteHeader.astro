---
import { siteConfig } from "../config/site";

const currentPath = Astro.url.pathname;
// Root is never subject to trailingSlash: "always" (there is no "//" URL),
// so the homepage path is always exactly "/".
const isHome = currentPath === "/";

const navLinkClass = (isActive: boolean) =>
  `rounded focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 ${
    isActive ? "text-stone-900" : "text-stone-600 hover:text-blue-600"
  }`;
---

<header class="border-b border-stone-200">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-3 px-6 py-5 sm:flex-row sm:items-center sm:justify-between sm:gap-x-8 sm:px-8 lg:px-12"
  >
    {
      /* Site wordmark, reading "Home" rather than the site name — this is
        the sole Home link, deliberately not duplicated in `siteConfig.nav`. */
    }
    <a
      href="/"
      aria-current={isHome ? "page" : undefined}
      class="rounded text-lg font-semibold tracking-tight text-stone-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900"
    >
      Home
    </a>
    <nav aria-label="Primary">
      <ul
        class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm font-medium sm:gap-x-8"
      >
        {
          siteConfig.nav.map((item) => {
            const isActive = item.href === currentPath;
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive ? "page" : undefined}
                  class={navLinkClass(isActive)}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
        {
          siteConfig.resumePath && (
            <li>
              <a
                href={siteConfig.resumePath}
                class="rounded border border-stone-300 px-3 py-1 text-stone-700 hover:border-blue-600 hover:text-blue-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900"
              >
                Resume
              </a>
            </li>
          )
        }
      </ul>
    </nav>
  </div>
</header>
